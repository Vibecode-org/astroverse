.git
.gitignore
**/.venv
**/node_modules
**/dist
**/.DS_Store
**/__pycache__
**/*.py[cod]
README.md
# Каталог генерируется при старте контейнера, в образ попадать не должен.
data/objects.json
# Бинарный и 100k-каталоги тоже генерируются локально: не раздуваем build context.
data/objects.bin
data/objects.v2.bin
data/objects_100k.json
# Generated sector indexes are built separately, not baked into the image.
data/sectors*.sqlite
data/*.runtime.sqlite
data/*.runtime.sqlite.lock
data/sectors*.sqlite.lock

# Local notes/configuration and generated test output are not image inputs.
.agent
.env
**/coverage
**/.pytest_cache
docs
