# Local dependencies and build output
**/.venv/
**/node_modules/
**/dist/

# Local environment overrides
.env

# Local agent memory: not part of the project, never commit
.agent/

# Generated catalog: built automatically inside the container
data/objects.json
# Local binary catalog and the 100k stress catalog: large, regenerable.
data/objects.bin
data/objects.v2.bin
data/objects_100k.json
# Offline sector-index artifacts (Phase 3.1).
data/sectors*.sqlite

# Python and OS artifacts
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
frontend/coverage/
.DS_Store
data/*.runtime.sqlite
# Persistent advisory lock inodes used by atomic runtime writers.
data/*.runtime.sqlite.lock
data/sectors*.sqlite.lock

# Runtime/debug logs stay local.
*.log
*.log.*
logs/
