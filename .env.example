# Скопируйте в .env и меняйте только то, что нужно.
# docker compose автоматически читает .env из корня проекта.

# offline — собрать каталог из data/catalog_seed.json (по умолчанию, без сети)
# online  — обновить NASA/JPL перед запуском (нужен интернет)
# existing — использовать уже готовый data/objects.json без пересборки
ASTROVERSE_CATALOG_MODE=offline

# Необязательный путь к каталогу. В контейнере data/ лежит в /app/data,
# поэтому указывайте абсолютный путь: /app/data/objects_100k.json.
# Относительный путь резолвится от WORKDIR образа (/app/backend), а не от корня
# проекта.
# ASTROVERSE_CATALOG_PATH=/app/data/objects_100k.json

# Интерфейс по умолчанию слушает все интерфейсы: доступен с телефона/другого
# компьютера в той же сети по адресу http://<IP-хоста>:5173
# Только этот компьютер: 127.0.0.1
ASTROVERSE_BIND=0.0.0.0
ASTROVERSE_PORT=5173

# Не нужно при работе через nginx (frontend и API на одном origin).
# Заполняйте, только если фронтенд открывается с другого адреса.
# ASTROVERSE_CORS_ORIGINS=http://localhost:5173,https://example.org
